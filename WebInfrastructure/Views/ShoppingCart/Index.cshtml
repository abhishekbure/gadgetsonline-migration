@using System.Globalization
@model ShoppingCartViewModel
@{
    ViewBag.Title = "Shopping Cart";
}

<h3>
    <em>Review</em> your cart:
</h3>
<p class="button">
    <a asp-controller="Checkout" asp-action="AddressAndPayment">Checkout &gt;&gt;</a>
</p>
<div id="update-message">
</div>
<table>
    <tr>
        <th>
            Pizza
        </th>
        <th>
            Price (each)
        </th>
        <th>
            Quantity
        </th>
        <th></th>
    </tr>
    @foreach (var item in Model.CartItems)
    {
        <tr id="row-@item.RecordId">
            <td>
                <a asp-controller="Store" asp-action="Details" asp-route-id="@item.ProductId">@item.Product?.Name</a>
            </td>
            <td>
                @item.Product?.Price.ToString("F2", CultureInfo.InvariantCulture)
            </td>
            <td id="item-count-@item.RecordId">
                @item.Count
            </td>
            <td>
                <a asp-controller="ShoppingCart" asp-action="RemoveFromCart" asp-route-id="@item.ProductId">Remove from cart</a>
            </td>
        </tr>
    }
    <tr>
        <td>
            Total
        </td>
        <td>
        </td>
        <td>
        </td>
        <td id="cart-total">
            @* An empty cart shows a bare 0, as the store always has; a cart with items shows the total with two decimals. *@
            @(Model.CartTotal == 0 ? "0" : Model.CartTotal.ToString("F2", CultureInfo.InvariantCulture))
        </td>
    </tr>
</table>
