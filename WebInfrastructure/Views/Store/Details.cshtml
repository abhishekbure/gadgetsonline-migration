@using System.Globalization
@model Product

@{
    ViewBag.Title = "Gadget - " + Model.Name;
}

<h2>@Model.Name</h2>

<p>
    <img alt="@Model.Name" src="@Model.ProductArtUrl" />
</p>

<div id="album-details">
    <p>
        <em>Type:</em>
        @Model.Category?.Name
    </p>
    <p>
        <em>Description:</em>
        @Model.Category?.Description
    </p>
    <p>
        <em>Price:</em>$
        @Model.Price.ToString("F", CultureInfo.InvariantCulture)
    </p>
    <p class="button">
        <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@Model.ProductId">Add to cart</a>
    </p>
</div>
