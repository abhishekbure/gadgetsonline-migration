<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="header" style="margin-top:10px">

        <h1 class="font-italic"><a href="/">
            Welcome to Gadgets Online!
             </a>
        </h1>

        <ul id="navlist">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><a>Welcome @User.Identity.Name</a></li>
            }
            <li><a href="~/" id="current">Home</a></li>
            <li><a href="~/ShoppingCart">ShoppingCart</a></li>
        </ul>
    </div>

    @await Component.InvokeAsync("CategoryMenu")

    <div id="main">
        @RenderBody()
    </div>

    <div id="footer">
        <a href="https://aws.amazon.com/developer/language/net/"> AWS &#10084;&#65039;  ASP.NET </a>
    </div>
</body>
</html>
